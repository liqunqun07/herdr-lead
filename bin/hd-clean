#!/usr/bin/env bash
# 用法: hd-clean <task_id>... | --all   关闭 pane 并删除工作文件
. "$(dirname "$0")/hd-common.sh"
[ $# -ge 1 ] || die "用法: hd-clean <task_id>... | --all"
if [ "$1" = "--all" ]; then set -- $(ls "$HD_DIR" 2>/dev/null); fi
for id in "$@"; do
  if [ -f "$HD_DIR/$id/pane" ]; then herdr pane close "$(cat "$HD_DIR/$id/pane")" >/dev/null 2>&1 || true; fi
  rm -rf "$HD_DIR/$id"
done
rm -f "$HD_DIR/.last_pane"; echo cleaned
