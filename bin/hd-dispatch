#!/usr/bin/env bash
# 用法: hd-dispatch <task_id> <alias> <task_file> [-t thinking] [--from PANE] [--dir right|down] [--cwd DIR]
# 作用: 开 herdr pane -> 用该别名对应的 CLI×模型 非交互执行 -> 任务文件自动附带汇报要求
. "$(dirname "$0")/hd-common.sh"
need herdr; need python3; require_configured; load_runners
[ $# -ge 3 ] || die "用法: hd-dispatch <task_id> <alias> <task_file> [-t thinking] [--from PANE] [--dir right|down] [--cwd DIR]"
ID="$1"; ALIAS="$2"; TASK="$3"; shift 3
THINK=""; FROM=""; DIR=""; CWD="$PWD"; LEADER="${HD_LEADER_PANE:-${HERDR_PANE_ID:-}}"
while [ $# -gt 0 ]; do case "$1" in
  -t|--thinking) THINK="$2"; shift 2;;
  --from) FROM="$2"; shift 2;;
  --dir) DIR="$2"; shift 2;;
  --cwd) CWD="$2"; shift 2;;
  *) die "未知参数 $1";; esac; done
[[ "$ID" =~ ^[A-Za-z0-9_-]+$ ]] || die "task_id 只能含字母数字-_"
[ -f "$TASK" ] || die "任务文件不存在: $TASK"
CWD="$(cd "$CWD" && pwd)" || die "工作目录不存在: $CWD"

ALIAS="$(resolve_alias "$ALIAS")"; row="$(lookup_model "$ALIAS")"; [ -n "$row" ] || die "配置里没有别名 ${ALIAS}（hd-models 查看）"
IFS='|' read -r RUNNER MODEL DTHINK ENABLED <<<"$row"
[ "$ENABLED" = yes ] || die "$ALIAS 已停用(enabled=$ENABLED)"
command -v "$RUNNER" >/dev/null || die "找不到 CLI: $RUNNER"
declare -F "run_$RUNNER" >/dev/null || die "不支持的 CLI: $RUNNER"
THINK="${THINK:-$DTHINK}"
case "$THINK" in off|low|medium|high) ;; *) die "thinking 只能是 off/low/medium/high";; esac
EFFORT="$THINK"; [ "$EFFORT" = off ] && EFFORT=low

W="$HD_DIR/$ID"; mkdir -p "$W"; rm -f "$W"/exit "$W"/report.md
# 完整提示 = 任务 + 固定汇报格式（指挥不用再写）
{ cat "$TASK"; cat <<EOT

---
## 汇报要求（必须做）
全部完成后，把汇报写入文件 $W/report.md ，格式：
- 状态: done / blocked / failed
- 改动文件列表
- 做了什么（3 句以内）
- 需要指挥决定的问题（没有写"无"）
只能改任务许可范围内的文件。写完 report.md 后结束，不要再做别的。
EOT
} > "$W/prompt.md"

# 启动脚本（pane 里跑；不论哪个 CLI，结束都会写 exit 文件，指挥靠它判断完成）
q(){ printf '%q' "$1"; }
cat > "$W/run.sh" <<EOS
#!/usr/bin/env bash
cd $(q "$CWD") || exit 1
export HD_HOME=$(q "$HD_HOME") HD_CONF_DIR=$(q "$HD_CONF_DIR")
export HD_MODEL=$(q "$MODEL") HD_THINK=$(q "$THINK") HD_EFFORT=$(q "$EFFORT") HD_PROMPT_FILE=$(q "$W/prompt.md")
. "\$HD_HOME/bin/hd-common.sh"; load_runners
echo "[hd] $ID  $RUNNER  $MODEL  thinking=$THINK"
run_$RUNNER < /dev/null 2>&1 | tee $(q "$W/log")
rc=\${PIPESTATUS[0]}; echo \$rc > $(q "$W/exit")
# 主动回报指挥 pane（指挥正在忙时 agent 会排队收到；失败不影响 hd-collect）
[ -n $(q "$LEADER") ] && [ "\${HD_NOTIFY:-1}" = 1 ] && herdr agent prompt $(q "$LEADER") "[herdr-dispatch] 任务 $ID 已结束(exit=\$rc)。运行 hd-collect $ID 查看汇报" >/dev/null 2>&1
exit 0
EOS
chmod +x "$W/run.sh"

# 从哪个 pane 切分：--from > 上次新开的 pane（保持排布）> $HERDR_PANE_ID
LAST="$HD_DIR/.last_pane"
if [ -z "$FROM" ] && [ -f "$LAST" ]; then FROM="$(cat "$LAST")"; fi
FROM="${FROM:-${HERDR_PANE_ID:-}}"
[ -n "$FROM" ] || die "不知道从哪个 pane 切分：请用 --from <pane_id> 或在 herdr 内运行"
if [ -z "$DIR" ]; then n=$(ls "$HD_DIR" | wc -l); if [ $((n % 2)) -eq 1 ]; then DIR=right; else DIR=down; fi; fi

OUT="$(herdr pane split "$FROM" --direction "$DIR" --no-focus)" || die "herdr split 失败: $OUT"
PANE="$(python3 -c 'import sys,json; print(json.loads(sys.stdin.read())["result"]["pane"]["pane_id"])' <<<"$OUT")" || die "解析 pane_id 失败: $OUT"
echo "$PANE" > "$W/pane"; echo "$PANE" > "$LAST"
herdr pane rename "$PANE" "${ID}·$RUNNER-$MODEL" >/dev/null 2>&1 || true
herdr pane run "$PANE" "bash $(q "$W/run.sh")" >/dev/null || die "herdr pane run 失败"
echo "dispatched $ID -> pane $PANE ($RUNNER $MODEL thinking=$THINK)"
