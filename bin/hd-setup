#!/usr/bin/env bash
# 配置 CLI × 模型偏好。首次由用户确认，之后派工不再询问；随时可用下列子命令修改。
USAGE='用法:
  hd-setup                          交互式向导（人在终端用；首次安装时自动运行）
  hd-setup status                   是否已配置 + 当前偏好
  hd-setup scan-clis                扫描本机支持的 CLI（claude pi codex agy）
  hd-setup scan-models [cli...]     扫描这些 CLI 的可用模型，生成带编号的候选（默认全部已安装的 CLI）
  hd-setup add <cli> <model>        手动补一个扫不到的候选
  hd-setup apply [--append] [--no-verify] <编号[:tier]>...
                                    按偏好顺序启用候选（越靠前越优先）并实测可调用；
                                    默认覆盖原配置，--append 追加到末尾
  hd-setup set <alias> key=value... 修改一项：enabled=yes|no tier=cheap|mid|strong
                                    thinking=off|low|medium|high rank=<n> when=<说明>
  hd-setup remove <alias>           删除一项
  hd-setup show-runner <cli>        显示该 CLI 的实际启动命令（含权限参数）
  hd-setup reset                    清空配置（下次派工前需重新确认）'
. "$(dirname "$0")/hd-common.sh"
load_runners
mkdir -p "$HD_CONF_DIR"; CAND="$HD_CONF_DIR/.candidates"
HEADER="# alias|runner|model|default_thinking|enabled|when_to_use|tier|rank"

installed_clis(){ for c in $HD_CLIS; do command -v "$c" >/dev/null 2>&1 && printf '%s ' "$c"; done; }
valid_cli(){ case " $HD_CLIS " in *" $1 "*) return 0;; esac; die "不支持的 CLI: $1（支持: ${HD_CLIS}）"; }

tier_guess(){ case "$(printf '%s' "$1" | tr 'A-Z' 'a-z')" in
  *flash*|*turbo*|*mini*|*lite*|*haiku*|*nano*|*air*|*luna*|*-low) echo cheap;;
  *opus*|*max*|*ultra*|*-pro*|*reason*|*thinking*|*sol*|*-high) echo strong;;
  *) echo mid;; esac; }
tier_thinking(){ case "$1" in cheap) echo low;; mid) echo medium;; strong) echo high;; esac; }
tier_when(){ case "$1" in
  cheap) echo "机械改动、批量替换、样板、简单测试";;
  mid) echo "普通功能实现、写测试、读代码总结";;
  strong) echo "需要推理的 bug 定位、重构、复杂实现";; esac; }
check_tier(){ case "$1" in cheap|mid|strong) ;; *) die "tier 只能是 cheap/mid/strong: $1";; esac; }
check_think(){ case "$1" in off|low|medium|high) ;; *) die "thinking 只能是 off/low/medium/high: $1";; esac; }

add_cand(){ local n; n=$(( $(wc -l < "$CAND" 2>/dev/null || echo 0) + 1 )); printf '%s|%s|%s|%s\n' "$n" "$1" "$2" "$(tier_guess "$2")" >> "$CAND"; }
lookup_cand(){ awk -F'|' -v n="$1" '$1==n{print $2"|"$3"|"$4}' "$CAND"; }
print_cands(){ if [ -s "$CAND" ]; then awk -F'|' '{printf "  %-4s %-7s %-44s %s\n",$1,$2,$3,$4}' "$CAND"
  else echo "  (空) 确认 CLI 已登录，或用 hd-setup add <cli> <model> 手动添加"; fi; }

scan_clis(){
  echo "== 本机 CLI（支持: ${HD_CLIS}）=="
  for c in herdr $HD_CLIS; do
    if command -v "$c" >/dev/null 2>&1; then
      v="$(tmo 5 "$c" --version 2>/dev/null | head -1)"; printf '  ✓ %-7s %s\n' "$c" "$v"
    else printf '  ✗ %-7s 未安装\n' "$c"; fi
  done
  command -v herdr >/dev/null || echo "  !! 没有 herdr，无法开窗口派工（先安装 herdr）"
  [ -n "$(installed_clis)" ] || echo "  !! 一个支持的 CLI 都没装"
}

scan_models(){
  local clis="$*"; [ -n "$clis" ] || clis="$(installed_clis)"
  : > "$CAND"
  for c in $clis; do valid_cli "$c"
    command -v "$c" >/dev/null 2>&1 || { echo "  ($c 未安装，跳过)"; continue; }
    out="$(tmo 30 bash -c ". '$HD_HOME/bin/hd-common.sh'; load_runners; list_$c" 2>/dev/null | awk 'NF && !s[$0]++')"
    if [ -n "$out" ]; then while read -r m; do add_cand "$c" "$m"; done <<<"$out"
    else echo "  ($c 的模型无法自动列出：用 hd-setup add $c <模型名> 手动补)"; fi
  done
  echo "== 候选（编号 CLI 模型 猜测级别；级别可在 apply 时用 编号:tier 改）=="
  print_cands
}

# runner model -> 0 表示实测能调用
verify(){
  local d; d="$(mktemp -d)"; echo "Reply with exactly OK" > "$d/prompt"
  ( cd "$d" && HD_MODEL="$2" HD_THINK=low HD_EFFORT=low HD_PROMPT_FILE="$d/prompt" \
      tmo "${HD_VERIFY_TIMEOUT:-240}" bash -c ". '$HD_HOME/bin/hd-common.sh'; load_runners; run_$1" ) < /dev/null > "$d/out" 2>&1
  local rc=$?; local ok=1; [ $rc -eq 0 ] && grep -q . "$d/out" && ok=0
  [ $ok -eq 0 ] || { echo "    rc=$rc 输出末尾: $(tail -c 300 "$d/out" | tr '\n' ' ')"; }
  rm -rf "$d"; return $ok
}

mk_alias(){ printf '%s-%s' "$1" "$(printf '%s' "${2##*/}" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' '-' | sed 's/--*/-/g; s/-*$//')"; }

apply(){
  local append=0 noverify=0
  while :; do case "${1:-}" in --append) append=1; shift;; --no-verify) noverify=1; shift;; *) break;; esac; done
  [ -s "$CAND" ] || die "没有候选，请先 hd-setup scan-models"
  [ $# -ge 1 ] || die "用法: hd-setup apply [--append] [--no-verify] <编号[:tier]>..."
  local tmp vd rank=0 used=" " i=0
  tmp="$(mktemp)"; vd="$(mktemp -d)"
  { echo "# 由 hd-setup 生成 $(date '+%F %T')；修改请用 hd-setup set/add/apply，见 hd-setup -h"; echo "$HEADER"; } > "$tmp"
  if [ $append -eq 1 ] && [ -f "$MODELS_CONF" ]; then
    conf_rows >> "$tmp"; rank=$(conf_rows | wc -l | tr -d ' ')
    used=" $(conf_rows | cut -d'|' -f1 | tr '\n' ' ')"
  fi
  local specs=()
  for spec in "$@"; do
    n="${spec%%:*}"; t="${spec#*:}"; [ "$t" = "$spec" ] && t=""
    row="$(lookup_cand "$n")"; [ -n "$row" ] || { echo "跳过: 没有编号 $n"; continue; }
    IFS='|' read -r r m g <<<"$row"; tier="${t:-$g}"; check_tier "$tier"
    alias="$(mk_alias "$r" "$m")"
    case "$used" in *" $alias "*) echo "跳过: $alias 已在配置里"; continue;; esac; used="$used$alias "
    i=$((i+1)); specs+=("$alias|$r|$m|$tier")
    # 并行实测，避免逐个等
    if [ $noverify -eq 0 ]; then ( verify "$r" "$m" > "$vd/$i.log" 2>&1; echo $? > "$vd/$i.rc" ) & fi
  done
  [ ${#specs[@]} -ge 1 ] || { rm -rf "$tmp" "$vd"; die "没有可写入的项"; }
  [ $noverify -eq 0 ] && { echo "实测 ${#specs[@]} 个模型能否调用（并行，最长 ${HD_VERIFY_TIMEOUT:-240}s）..."; wait; }
  local ok=0 j=0
  for s in "${specs[@]}"; do j=$((j+1)); IFS='|' read -r alias r m tier <<<"$s"
    en=yes
    if [ $noverify -eq 0 ]; then
      if [ "$(cat "$vd/$j.rc" 2>/dev/null)" = 0 ]; then echo "  ✓ $alias"; else echo "  ✗ ${alias}（已标记 enabled=no）"; cat "$vd/$j.log"; en=no; fi
    fi
    [ $en = yes ] && ok=$((ok+1))
    rank=$((rank+1)); echo "$alias|$r|$m|$(tier_thinking "$tier")|$en|$(tier_when "$tier")|$tier|$rank" >> "$tmp"
  done
  rm -rf "$vd"
  if [ $ok -lt 1 ] && [ $append -eq 0 ]; then rm -f "$tmp"; die "没有任何模型通过实测，未写入配置。检查 CLI 登录状态后重试"; fi
  mv "$tmp" "$MODELS_CONF"; echo; echo "已写入 $MODELS_CONF"; "$(dirname "$0")/hd-models"
}

# 改一项；rank=n 表示把它挪到第 n 位，其余顺延
set_item(){
  local a="$1"; shift; [ -n "$(lookup_model "$a")" ] || die "配置里没有 ${a}（hd-setup status 查看）"
  local en="" tier="" th="" rk="" when=""
  for kv in "$@"; do k="${kv%%=*}"; v="${kv#*=}"; [ "$k" != "$kv" ] || die "参数要写成 key=value: $kv"
    case "$k" in
      enabled) case "$v" in yes|no) en="$v";; *) die "enabled 只能是 yes/no";; esac;;
      tier) check_tier "$v"; tier="$v";;
      thinking) check_think "$v"; th="$v";;
      rank) [[ "$v" =~ ^[0-9]+$ ]] && [ "$v" -ge 1 ] || die "rank 要是正整数"; rk="$v";;
      when) case "$v" in *'|'*) die "when 里不能有 |";; esac; when="$v";;
      *) die "未知字段 ${k}（可改 enabled tier thinking rank when）";;
    esac; done
  local tmp; tmp="$(mktemp)"
  { grep '^[[:space:]]*#' "$MODELS_CONF"
    conf_rows | awk -F'|' -v OFS='|' -v a="$a" -v en="$en" -v tier="$tier" -v th="$th" -v rk="$rk" -v w="$when" '
      $1==a { if(en!="")$5=en; if(tier!="")$7=tier; if(th!="")$4=th; if(w!="")$6=w; if(rk!="")$8=rk-0.5 } {print}' \
    | sort -t'|' -k8,8g | awk -F'|' -v OFS='|' '{$8=NR; print}'; } > "$tmp"
  mv "$tmp" "$MODELS_CONF"; "$(dirname "$0")/hd-models"
}

remove_item(){
  [ -n "$(lookup_model "$1")" ] || die "配置里没有 $1"
  local tmp; tmp="$(mktemp)"
  { grep '^[[:space:]]*#' "$MODELS_CONF"; conf_rows | awk -F'|' -v OFS='|' -v a="$1" '$1!=a' | sort -t'|' -k8,8g | awk -F'|' -v OFS='|' '{$8=NR; print}'; } > "$tmp"
  mv "$tmp" "$MODELS_CONF"; echo "已删除 $1"
}

status(){
  if configured; then echo "状态: 已配置（${MODELS_CONF}）"; "$(dirname "$0")/hd-models"
  else echo "状态: 未配置。首次使用需用户确认 CLI 与模型偏好（hd-setup 向导，或 scan-clis → scan-models → apply）"; return 1; fi
}

ask(){ local a; read -r -p "$1" a < /dev/tty; printf '%s' "$a"; }
wizard(){
  echo "== herdr-dispatch 首次配置：选 CLI → 选模型和偏好顺序 → 实测 → 保存 =="
  echo "（之后派工不再询问；随时可用 hd-setup set/add/apply 修改，hd-setup -h 看用法）"; echo
  scan_clis; local inst; inst="$(installed_clis)"; [ -n "$inst" ] || die "没有可用的 CLI"
  echo; clis="$(ask "启用哪些 CLI？空格分隔，回车=全部已安装 [$inst]: ")"; clis="${clis:-$inst}"
  echo "这些 CLI 在派工窗口里无人值守运行，默认跳过权限确认。实际命令："
  for c in $clis; do valid_cli "$c"; declare -f "run_$c" | sed -n '3p' | sed "s/^ */  $c: /"; done
  echo "  （要收紧权限：在 $HD_CONF_DIR/runners.local.sh 里重定义 run_<cli>）"; echo
  scan_models $clis; [ -s "$CAND" ] || exit 1
  echo; echo "补充扫不到的模型：格式 cli:模型，空格分隔，回车跳过"
  for x in $(ask "> "); do valid_cli "${x%%:*}"; add_cand "${x%%:*}" "${x#*:}"; done
  print_cands
  echo; echo "按偏好顺序输入要启用的编号（越靠前越优先；同级别里优先用靠前的）。例: 3 1 7"
  picks="$(ask "> ")"; [ -n "$picks" ] || die "未选择"
  echo "级别决定分到什么难度的活：cheap=机械活  mid=普通实现  strong=复杂推理"
  ov="$(ask "要改级别的写 编号=级别（如 3=strong 7=cheap），回车跳过: ")"
  spec=(); for p in $picks; do t=""; for o in $ov; do [ "${o%%=*}" = "$p" ] && t=":${o#*=}"; done; spec+=("$p$t"); done
  apply "${spec[@]}"
}

case "${1:-}" in
  "") if [ -t 0 ]; then wizard; else echo "$USAGE"; echo; status; fi;;
  wizard) wizard;;
  status) status;;
  scan-clis) scan_clis;;
  scan-models) shift; scan_models "$@";;
  add) [ $# -eq 3 ] || die "用法: hd-setup add <cli> <model>"; valid_cli "$2"; touch "$CAND"; add_cand "$2" "$3"; print_cands;;
  apply) shift; apply "$@";;
  set) [ $# -ge 3 ] || die "用法: hd-setup set <alias> key=value..."; shift; set_item "$@";;
  remove) [ $# -eq 2 ] || die "用法: hd-setup remove <alias>"; remove_item "$2";;
  show-runner) [ $# -eq 2 ] || die "用法: hd-setup show-runner <cli>"; valid_cli "$2"; declare -f "run_$2";;
  reset) rm -f "$MODELS_CONF" "$CAND"; echo "已清空配置";;
  -h|--help|help) echo "$USAGE";;
  *) die "未知子命令 $1（hd-setup -h）";;
esac
