#!/usr/bin/env bash
# 用法: hd-collect [-T 秒] <task_id>...   等待全部完成并打印汇报（默认最多等 540s，没完成就再运行一次）；超时的打印 pane 现场
. "$(dirname "$0")/hd-common.sh"
TO="${HD_COLLECT_TIMEOUT:-540}"; if [ "${1:-}" = "-T" ]; then TO="$2"; shift 2; fi
[ $# -ge 1 ] || die "用法: hd-collect [-T 秒] <task_id>..."
start=$(date +%s)
while :; do
  left=0; for id in "$@"; do [ -f "$HD_DIR/$id/exit" ] || left=$((left+1)); done
  [ $left -eq 0 ] && break
  [ $(( $(date +%s) - start )) -ge "$TO" ] && break
  sleep 3
done
for id in "$@"; do
  W="$HD_DIR/$id"; echo "=================== $id ==================="
  if [ ! -f "$W/exit" ]; then
    echo "[TIMEOUT] 仍在运行，pane 现场："
    herdr pane read "$(cat "$W/pane")" --source recent --lines 40 2>&1 | tail -40
    continue
  fi
  echo "exit code: $(cat "$W/exit")"
  if [ -f "$W/report.md" ]; then cat "$W/report.md"
  else echo "[无 report.md] 日志末尾："; tail -30 "$W/log" 2>/dev/null; fi
done
